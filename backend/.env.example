# CallFlow Backend Environment Configuration

# Server Port (Render or local dev)
PORT=8000

# CORS Allowed Origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API Key (Server-side only — never expose to client)
# Used for generating structured call summaries, analysis, and transcription
GEMINI_API_KEY=your_gemini_api_key_here

# Optional backup Gemini API key. Used automatically when the primary key
# hits its quota/rate limit, so requests fail over instead of failing.
GEMINI_API_KEY_2=

# Mistral API key for post-call summary, conversation-gap, and radar analysis
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=ministral-14b-latest

# Supabase PostgreSQL Configuration (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
